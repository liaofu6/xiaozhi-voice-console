# ===== 小智音乐 MCP 配置示例 =====
# 复制为 .env 并填入自己的值（.env 不会被 git 追踪）

# 服务监听端口
PORT=3000

# 小智 MCP 接入点，形如 wss://api.xiaozhi.me/mcp/?token=xxxx
# 留空则只启动本地 HTTP 服务，不连接小智
MCP_ENDPOINT=

# 网易云登录 Cookie（可选）。填了才能取 VIP / 无损曲目
METING_NETEASE_COOKIE=

# 设备侧访问本服务的基地址。留空自动探测局域网 IP
PUBLIC_BASE=

# 本地 Meting（多平台：QQ/酷狗）接口地址
METING_API=http://127.0.0.1:3300/api.php

# ffmpeg 可执行文件路径，留空使用 PATH 中的 ffmpeg
FFMPEG=

# ===== 以下仅控制台 panel.js 使用 =====
PANEL_PORT=3210
SERVICE_PORT=3000
METING_PORT=3300
# PHP 可执行文件，留空使用 PATH 中的 php
PHP_EXE=

# ===== AI 转接（小智自建服务端）=====
# 小智服务端目录，需包含 main/xiaozhi-server/app.py
# 留空则自动探测 E:\ / D:\ / C:\ 下的 xiaozhi-esp32-server
XIAOZHI_SERVER_DIR=
# 服务端 venv 的 python，留空自动用 <目录>/.venv/Scripts/python.exe
XIAOZHI_PYTHON=
# 服务端 WebSocket / OTA 端口（与 data/.config.yaml 保持一致）
XIAOZHI_WS_PORT=8000
XIAOZHI_OTA_PORT=8003
